filters:
  and:
    - file.folder == "RPGs"
    - '!file.name.contains("campaign")'
    - file.name != "index"
views:
  - type: cards
    name: View
    order:
      - file.name
    sort:
      - property: date_finished
        direction: DESC
    image: note.image
    cardSize: 180
    imageAspectRatio: 1.5

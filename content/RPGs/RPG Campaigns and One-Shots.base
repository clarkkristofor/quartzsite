filters:
  and:
    - file.folder == "RPGs"
    - '!file.name.contains("campaign")'
    - file.name != "index"
views:
  - type: cards
    name: View
    order:
      - file.name
    sort:
      - property: date_finished
        direction: DESC
    image: note.image
    cardSize: 180
    imageAspectRatio: 0.65
  - type: table
    name: List
    groupBy:
      property: GM
      direction: DESC
    order:
      - file.name
      - Game
      - GM
      - date
      - date_finished
    sort:
      - property: date_finished
        direction: DESC
    columnSize:
      note.GM: 81

filters:
  and:
    - file.folder == "RPGs/protected/sb/playtest beta oracle deck"
    - '!file.name.contains("oracle")'
views:
  - type: table
    name: Table
    order:
      - file.name
      - card type
      - publish
      - unlisted
      - password
      - description
    sort:
      - property: file.name
        direction: ASC
      - property: card type
        direction: ASC
    columnSize:
      note.password: 154

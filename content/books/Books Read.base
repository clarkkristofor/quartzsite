filters:
  and:
    - file.folder == "books"
    - '!file.name.contains("books read")'
    - "!date_finished.isEmpty()"
formulas:
  book: link(link, title)
  redirect: link(link, title)
properties:
  formula.redirect:
    displayName: book
views:
  - type: table
    name: List
    order:
      - title
      - author
      - link
    sort:
      - property: date_finished
        direction: DESC
    columnSize:
      formula.redirect: 247
  - type: cards
    name: Covers
    filters:
      and:
        - file.folder == "books"
        - '!file.name.contains("books read")'
        - "!date_finished.isEmpty()"
    order: []
    sort:
      - property: date_finished
        direction: DESC
    cardSize: 120
    image: note.image
    imageAspectRatio: 1.5
